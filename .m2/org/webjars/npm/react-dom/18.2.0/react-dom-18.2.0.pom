<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <packaging>jar</packaging>
    <groupId>org.webjars.npm</groupId>
    <artifactId>react-dom</artifactId>
    <version>18.2.0</version>
    <name>react-dom</name>
    <description>WebJar for react-dom</description>
    <url>https://www.webjars.org</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <scm>
        <url>https://github.com/facebook/react</url>
        <connection>https://github.com/facebook/react.git</connection>
        <developerConnection>https://github.com/facebook/react.git</developerConnection>
        <tag>v18.2.0</tag>
    </scm>

    <developers>
        <developer>
            <id>webjars</id>
            <url>https://www.webjars.org</url>
        </developer>
    </developers>

    <licenses>
        
            <license>
                
                    <name>MIT</name>
                
                
                <distribution>repo</distribution>
            </license>
        
    </licenses>

    
    <issueManagement>
        <url>https://github.com/facebook/react/issues</url>
    </issueManagement>
    

    <dependencies>
        
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>loose-envify</artifactId>
            <version>[1.1.0,2)</version>
        </dependency>
        
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>scheduler</artifactId>
            <version>[0.23.0,0.24)</version>
        </dependency>
        
        
    </dependencies>

</project>