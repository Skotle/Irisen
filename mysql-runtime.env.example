# Copy this file to a VM-only location, for example:
#   sudo install -d -m 700 /etc/irisen
#   sudo cp mysql-runtime.env.example /etc/irisen/mysql-runtime.env
#   sudo chmod 600 /etc/irisen/mysql-runtime.env
#
# Do not commit the completed file or share its credential values.

APP_SERVER_PORT=8080
APP_DB_HOST=127.0.0.1
APP_DB_USER=your_mysql_user
APP_DB_PASSWORD=replace_with_mysql_password
APP_SMTP_EMAIL=your_smtp_email@example.com
APP_SMTP_PASSWORD=replace_with_smtp_password
APP_ADMIN_LOGIN_CODE=replace_with_at_least_32_random_characters
APP_ADMIN_ALLOWED_ADDRESSES=203.0.113.10
